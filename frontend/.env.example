# Frontend Environment Variables Example
# Duplicate to .env for local dev or .env.production for production / Vercel

# Base URL for Backend API
# For local development (using Vite proxy), leave empty or set to http://127.0.0.1:8001
# For Vercel demo with Ngrok backend, set to your ngrok forwarding URL (e.g. https://xxxx.ngrok-free.app)
VITE_API_URL=
